wait-for Search the web
shot start-page
tap-id address
expect Search or enter address
shot start-keyboard
tap-id kb.cancel
tap-id samples
expect Sample pages
tap-id navigate
tap-id page-view
expect Sample pages
shot page-address-bar
tap-id edit-address
expect samples.browse.invalid
shot page-address-edit

tap-id kb.r0c0
expect samples.browse.invalid/q
tap-id kb.cancel
expect Sample pages
shot page-keyboard-dismissed
tap-id zoom-more
expect Sample pages
shot page-zoomed
tap-id browser-more
expect Set Page as Home
shot browser-menu
tap-id set-home
tap-id browser-more
tap-id add-favourite
tap-id browser-more
tap-id edit-address
tap-id url-slash
tap-id url-dot
tap-id url-com
tap-id url-colon
expect /..com:
shot url-keyboard
tap-id kb.cancel
tap-id reload
expect Sample pages
shot page-reloaded
