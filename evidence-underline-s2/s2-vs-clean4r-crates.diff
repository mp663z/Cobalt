+fn underline_char_allowed(c: char) -> bool {
+    match c {
+        'A'..='Z' => c != 'Q',
+        'a'..='z' => !matches!(c, 'g' | 'j' | 'p' | 'q' | 'y'),
+        '0'..='9' | ' ' | '.' | ':' | '!' | '?' | '-' | '/' | '\\' | '\'' | '"' | '#' | '&' | '*' | '+' | '=' | '%' => true,
+        _ => false,
+    }
