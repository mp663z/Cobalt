+    let t = optin(&page(&format!("<link rel=stylesheet href=\"{at}A\">")), &[], &Limits::DEFAULT, None, b);
+    assert_eq!(t.diagnostics.dropped_attributes, 1);
+    assert_eq!(t.diagnostics.retained_inline_sheet_href_bytes, 0);
