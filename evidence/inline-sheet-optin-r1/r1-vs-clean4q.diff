+    let d = plain(&page(&format!("<link rel=stylesheet href=\"{at}\">")), &[], &Limits::DEFAULT, None, b);
+    assert_eq!((d.diagnostics.dropped_attributes, d.diagnostics.retained_inline_sheet_href_bytes), (1, 0));
+}
